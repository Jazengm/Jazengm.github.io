---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import HouseToy from "../components/HouseToy";
---

<BaseLayout
  title="Pocket House"
  description="A small, playful House music instrument. No musical experience needed."
>
  <div class="play-intro">
    <PageHeader
      eyebrow="An audiovisual instrument"
      title="Pocket House"
      lede="Play a sound. Draw a small universe."
    />
  </div>
  <HouseToy client:visible />
  <noscript
    ><p>
      This instrument needs JavaScript and a browser with Web Audio support. No
      sound plays automatically.
    </p></noscript
  >
</BaseLayout>

<style>
  .play-intro :global(.page-header) {
    margin-bottom: 1.5rem;
  }
  .play-intro :global(.page-title) {
    font-size: clamp(2rem, 4vw, 3.2rem);
  }
  .play-intro :global(.page-lede) {
    font-size: 1rem;
    margin-top: 0.6rem;
  }
</style>
