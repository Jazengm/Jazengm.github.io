---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { withBase } from "../../utils/paths";

const experiments = await getCollection("experiments");
---

<BaseLayout
  title="Experiments"
  description="A directory of small, focused mathematical programs."
>
  <PageHeader
    eyebrow="Programs and visualizations"
    title="Experiments"
    lede="Self-contained mathematical programs live here, separate from static academic content and hydrated only when interaction is useful."
  />
  <div class="experiment-grid section-block decorated-section">
    <span class="halftone-dots" aria-hidden="true"></span>
    {
      experiments.map((experiment) => (
        <article class="experiment-card quiet-card">
          {experiment.data.thumbnail && (
            <Image
              src={experiment.data.thumbnail}
              alt={experiment.data.thumbnailAlt ?? ""}
              width={720}
              format="svg"
            />
          )}
          <div>
            <p class="eyebrow">Experiment</p>
            <h2>
              <a href={withBase(`/experiments/${experiment.id}/`)}>
                {experiment.data.title}
              </a>
            </h2>
            <p>{experiment.data.description}</p>
            <ul class="tag-list">
              {experiment.data.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</BaseLayout>

<style>
  .experiment-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 21rem), 1fr));
    gap: var(--space-4);
  }
  .experiment-card {
    overflow: hidden;
    border-top: 3px solid var(--color-primary);
    transition:
      border-color var(--transition-fast),
      translate var(--transition-fast);
  }
  .experiment-card:hover,
  .experiment-card:focus-within {
    border-top-color: var(--color-secondary);
    translate: 0 -2px;
  }
  .experiment-card img {
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 5;
    object-fit: cover;
  }
  .experiment-card > div {
    padding: var(--space-4);
  }
  .experiment-card h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.55rem;
  }
  .experiment-card p:not(.eyebrow) {
    color: var(--color-text-muted);
  }
</style>
