---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FractalExplorer from '../../components/FractalExplorer';

const experiment = await getEntry('experiments', 'fractal');
if (!experiment) throw new Error('Missing experiment metadata for fractal');
---

<BaseLayout
  title={experiment.data.title}
  description={experiment.data.description}
>
  <header class="content-column">
    <p class="eyebrow">Complex dynamics</p>
    <h1 class="page-title">{experiment.data.title}</h1>
    <p class="page-lede">{experiment.data.description}</p>
    <p>
      Drag to pan, use the wheel or buttons to zoom, adjust iteration depth, switch to a Julia set,
      and export the current canvas as a PNG. Rendering is bounded and runs in a Web Worker.
    </p>
  </header>
  <FractalExplorer client:visible />
</BaseLayout>
