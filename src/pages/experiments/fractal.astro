---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import FractalExplorer from "../../components/FractalExplorer";
import PageHeader from "../../components/PageHeader.astro";

const experiment = await getEntry("experiments", "fractal");
if (!experiment) throw new Error("Missing experiment metadata for fractal");
---

<BaseLayout
  title={experiment.data.title}
  description={experiment.data.description}
>
  <PageHeader
    eyebrow="Complex dynamics"
    title={experiment.data.title}
    lede={experiment.data.description}
  >
    <p>
      Drag to pan, use the wheel or buttons to zoom, adjust iteration depth,
      switch to a Julia set, and export the current canvas as a PNG. Rendering
      is bounded and runs in a Web Worker.
    </p>
  </PageHeader>
  <FractalExplorer client:visible />
</BaseLayout>
