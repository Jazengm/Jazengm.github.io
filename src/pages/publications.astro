---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import PublicationList from "../components/PublicationList.astro";
---

<BaseLayout
  title="Articles"
  description="A collection of papers, preprints, and supporting material."
>
  <PageHeader
    eyebrow="Writing and results"
    title="Articles"
    lede="Browse the complete collection of publications."
  />
  <div class="section-block publication-section">
    <PublicationList />
  </div>
</BaseLayout>

<style>
  .publication-section {
    margin-top: var(--space-6);
  }
</style>
