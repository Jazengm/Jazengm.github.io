---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { withBase } from "../../utils/paths";

const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedDate.valueOf() - a.data.publishedDate.valueOf(),
);
---

<BaseLayout
  title="Notes"
  description="Expository articles, lecture notes, and interactive writing."
>
  <PageHeader
    eyebrow="MDX collection"
    title="Notes"
    lede="Long-form mathematical writing with native Markdown, KaTeX formulas, and optional focused interactive islands."
  />
  <ol class="note-list section-block">
    {
      notes.map((note) => (
        <li>
          <article>
            <p>
              <time datetime={note.data.publishedDate.toISOString()}>
                {note.data.publishedDate.getFullYear()}
              </time>
            </p>
            <div>
              <h2>
                <a href={withBase(`/notes/${note.id}/`)}>{note.data.title}</a>
              </h2>
              <p>{note.data.description}</p>
              <ul class="tag-list">
                {note.data.tags.map((tag) => (
                  <li class="tag">{tag}</li>
                ))}
              </ul>
            </div>
          </article>
        </li>
      ))
    }
  </ol>
</BaseLayout>

<style>
  .note-list {
    margin-bottom: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
  }
  .note-list article {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }
  .note-list article > p {
    margin: 0;
    color: var(--color-text-muted);
  }
  .note-list h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 550;
  }
  .note-list h2 + p {
    color: var(--color-text-muted);
  }
  @media (max-width: 480px) {
    .note-list article {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
