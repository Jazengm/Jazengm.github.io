---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import { researchThemes } from "../config/site";

const publications = await getCollection("publications");
const publicationsById = new Map(
  publications.map((entry) => [entry.id, entry.data]),
);
---

<BaseLayout
  title="Research"
  description="Research themes, organizing questions, and links to related publications."
>
  <PageHeader
    eyebrow="Questions and methods"
    title="Research"
    lede="A compact map of research directions. Theme descriptions live in site configuration; related publications resolve from the content collection by identifier."
  />

  <div class="research-themes section-block decorated-section">
    <span class="halftone-dots" aria-hidden="true"></span>
    {
      researchThemes.map((theme, index) => (
        <section
          class="research-theme"
          id={theme.id}
          aria-labelledby={`${theme.id}-heading`}
        >
          <div
            class={`theme-symbol theme-symbol-${theme.symbol}`}
            aria-hidden="true"
          >
            <span />
            <span />
            <span />
          </div>
          <div>
            <p class="theme-index">0{index + 1}</p>
            <h2 class="section-heading" id={`${theme.id}-heading`}>
              {theme.title}
            </h2>
            <p>{theme.summary}</p>
            <ul class="tag-list">
              {theme.keywords.map((keyword) => (
                <li class="tag">{keyword}</li>
              ))}
            </ul>
            {theme.publicationIds.length > 0 && (
              <>
                <h3>Related publications</h3>
                <ul class="related-publications">
                  {theme.publicationIds.map((id) => {
                    const publication = publicationsById.get(id);
                    return publication ? (
                      <li>
                        {publication.title} ({publication.year})
                      </li>
                    ) : null;
                  })}
                </ul>
              </>
            )}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .research-themes {
    border-top: 1px solid var(--color-border);
  }

  .research-theme {
    display: grid;
    grid-template-columns: minmax(8rem, 0.45fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 6vw, 6rem);
    padding-block: clamp(2.5rem, 7vw, 5rem);
    border-bottom: 1px solid var(--color-border);
  }

  .research-theme > div:last-child {
    max-width: var(--content-width);
  }

  .theme-index {
    margin: 0;
    color: var(--color-secondary-strong);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .research-theme h3 {
    margin: var(--space-5) 0 var(--space-2);
    font-family: var(--font-serif);
    font-size: 1.1rem;
  }

  .theme-symbol {
    position: relative;
    width: 8rem;
    height: 8rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
  }

  .theme-symbol span {
    position: absolute;
    inset: 50% auto auto 50%;
    width: 0.8rem;
    height: 0.8rem;
    border-radius: 50%;
    background: var(--color-primary);
  }

  .theme-symbol span:first-child {
    background: var(--color-secondary);
  }

  .theme-symbol span:nth-child(1) {
    translate: -3rem -2rem;
  }
  .theme-symbol span:nth-child(2) {
    translate: 1.7rem -0.4rem;
  }
  .theme-symbol span:nth-child(3) {
    translate: -1rem 2rem;
  }

  .related-publications {
    padding-left: 1.25rem;
  }

  @media (max-width: 600px) {
    .research-theme {
      grid-template-columns: 1fr;
    }
    .theme-symbol {
      width: 5rem;
      height: 5rem;
    }
    .theme-symbol span:nth-child(1) {
      translate: -2rem -1.2rem;
    }
    .theme-symbol span:nth-child(2) {
      translate: 0.9rem -0.4rem;
    }
    .theme-symbol span:nth-child(3) {
      translate: -0.7rem 1rem;
    }
  }
</style>
