---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import { withBase } from "../../utils/paths";

const seminars = (await getCollection("seminars")).sort(
  (left, right) =>
    left.data.order - right.data.order ||
    left.data.title.localeCompare(right.data.title),
);
---

<BaseLayout
  title="Seminars"
  description="Seminar programs, descriptions, and materials."
>
  <PageHeader
    eyebrow="Reading and discussion"
    title="Seminars"
    lede="Seminar programs and working descriptions."
  />

  <ul class="seminar-list section-block">
    {
      seminars.map((seminar) => (
        <li>
          <a href={withBase(`/seminars/${seminar.id}/`)}>
            {seminar.data.title} ({seminar.data.term})
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .seminar-list {
    margin-bottom: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
  }

  .seminar-list li {
    border-bottom: 1px solid var(--color-border);
  }

  .seminar-list a {
    display: block;
    padding-block: var(--space-4);
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 3vw, 1.65rem);
    font-weight: 550;
    text-decoration-thickness: 0.06em;
  }
</style>
