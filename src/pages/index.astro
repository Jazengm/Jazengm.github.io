---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResearchMap, { type ResearchMapNode } from '../components/ResearchMap';
import { site } from '../config/site';
import { withBase } from '../utils/paths';

const primaryLinks = site.navigation.filter((item) => item.href !== '/');
const positions = [
  [360, 155],
  [120, 85],
  [590, 70],
  [650, 235],
  [120, 245],
] as const;
const atlasItems = site.navigation.filter(
  (item) => item.href !== '/' && item.href !== '/about',
);
const atlasNodes: ResearchMapNode[] = atlasItems.map((item, index) => ({
  ...item,
  href: withBase(item.href),
  x: positions[index]?.[0] ?? 360,
  y: positions[index]?.[1] ?? 155,
}));

const contactLinks = [
  site.email && { label: 'Email', href: `mailto:${site.email}` },
  site.cvUrl && { label: 'CV', href: site.cvUrl },
  site.github && { label: 'GitHub', href: site.github },
  site.orcid && { label: 'ORCID', href: site.orcid },
  site.googleScholar && { label: 'Google Scholar', href: site.googleScholar },
].filter(Boolean) as { label: string; href: string }[];
---

<BaseLayout>
  <section class="home-intro content-column">
    <p class="eyebrow">{site.currentPosition} · {site.institution}</p>
    <h1 class="page-title">{site.name}</h1>
    {site.tagline && <p class="home-tagline">{site.tagline}</p>}
    <div class="home-biography">
      {site.biography.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    {
      site.isPlaceholder && (
        <p class="placeholder-note">
          This profile intentionally contains centralized placeholders. See the README customization
          checklist before publishing it as a personal record.
        </p>
      )
    }
    {
      contactLinks.length > 0 && (
        <ul class="inline-links" aria-label="Profile links">
          {contactLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  <section class="section-block" aria-labelledby="paths-heading">
    <p class="eyebrow">Paths</p>
    <h2 class="section-heading" id="paths-heading">Start with a section</h2>
    <ul class="link-grid">
      {
        primaryLinks.map((item) => (
          <li>
            <a href={withBase(item.href)}>
              <strong>{item.label}</strong>
              <span>{item.description}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="section-block">
    <ResearchMap nodes={atlasNodes} client:visible />
  </div>
</BaseLayout>

<style>
  .home-intro {
    padding-top: clamp(1rem, 4vw, 3rem);
  }

  .home-tagline {
    max-width: 56ch;
    margin-block: var(--space-4) var(--space-5);
    color: var(--color-muted);
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 3vw, 1.85rem);
    line-height: 1.35;
  }

  .home-biography {
    max-width: var(--content-width);
  }

  .inline-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding: 0;
    list-style: none;
  }
</style>
