---
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeArtwork from "../components/HomeArtwork.astro";
import ProfileLinks from "../components/ProfileLinks.astro";
import { site } from "../config/site";
---

<BaseLayout mainClass="home-main">
  <div class="home-hero">
    <HomeArtwork />
    <div class="home-content site-shell">
      <section class="home-intro" aria-labelledby="home-name">
        <p class="eyebrow">{site.currentPosition} · {site.institution}</p>
        <h1 class="page-title" id="home-name">{site.name}</h1>
        {site.tagline && <p class="home-tagline">{site.tagline}</p>}
        <div class="home-biography">
          {site.biography.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <ProfileLinks />
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  :global(.site-main.home-main) {
    width: 100%;
    padding: 0;
  }

  .home-hero {
    position: relative;
    isolation: isolate;
  }

  .home-content {
    position: relative;
    min-height: max(32rem, calc(100svh - 13rem));
    display: flex;
    align-items: center;
    padding-block: clamp(4rem, 10vw, 8rem);
    pointer-events: none;
  }

  .home-intro {
    width: 48%;
    pointer-events: auto;
  }

  .home-tagline {
    margin-block: var(--space-4) var(--space-5);
    color: var(--color-text-muted);
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 3vw, 1.85rem);
    line-height: 1.35;
  }

  .home-biography {
    max-width: var(--content-width);
  }

  @media (max-width: 640px) {
    .home-intro {
      width: 80%;
    }

    .page-title {
      font-size: clamp(2rem, 8vw, 3.2rem);
    }
  }
</style>
