---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ProfileLinks from "../components/ProfileLinks.astro";
import ResearchMap, { type ResearchMapNode } from "../components/ResearchMap";
import { site } from "../config/site";
import { withBase } from "../utils/paths";
import { comparePublications } from "../utils/publications";
import EventList from "../components/EventList.astro";
import { eventSnapshot } from "../config/events";
import { partitionEvents } from "../utils/events";
const { current: upcomingEvents } = partitionEvents(
  await getCollection("events"),
  eventSnapshot.reviewedOn,
);

const atlasItems = site.navigation.filter(
  (item) => item.href !== "/" && item.href !== "/about",
);
const atlasNodes: ResearchMapNode[] = atlasItems.map((item) => ({
  ...item,
  href: withBase(item.href),
}));

const ownerNames = new Set<string>([site.name, ...site.authorNameMatches]);
const authorList = new Intl.ListFormat("en", {
  style: "long",
  type: "conjunction",
});
const selectedPaperCitations = (
  await getCollection("publications", ({ data }) => data.selected)
)
  .sort(comparePublications)
  .map(({ id, data }) => {
    const coauthors = data.authors.filter((author) => !ownerNames.has(author));
    const collaboration =
      coauthors.length > 0 ? ", with " + authorList.format(coauthors) : "";
    return {
      id,
      text:
        data.title +
        collaboration +
        ". " +
        (data.venue ?? "Preprint") +
        " (" +
        data.year +
        ").",
    };
  });
---

<BaseLayout>
  <section class="home-intro content-column decorated-section">
    <span class="halftone-dots" aria-hidden="true"></span>
    <p class="eyebrow">{site.currentPosition} · {site.institution}</p>
    <h1 class="page-title">{site.name}</h1>
    {site.tagline && <p class="home-tagline">{site.tagline}</p>}
    <div class="home-biography">
      {site.biography.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    {
      site.isPlaceholder && (
        <p class="placeholder-note">
          This profile intentionally contains centralized placeholders. See the
          README customization checklist before publishing it as a personal
          record.
        </p>
      )
    }
    <ProfileLinks />
  </section>

  <section class="section-block" aria-labelledby="selected-papers-heading">
    <p class="eyebrow">Writing and results</p>
    <h2 class="section-heading" id="selected-papers-heading">
      Selected papers
    </h2>
    <ol class="selected-publications">
      {
        selectedPaperCitations.map((citation) => (
          <li data-publication-id={citation.id}>{citation.text}</li>
        ))
      }
    </ol>
  </section>

  <div class="section-block">
    <ResearchMap nodes={atlasNodes} client:visible />
  </div>
  <section class="section-block" aria-labelledby="home-events-heading">
    <p class="eyebrow">Academic calendar</p>
    <h2 class="section-heading" id="home-events-heading">Events</h2>
    <p>Geometry and combinatorics meetings in China and nearby regions.</p>
    <p>
      <span>Last reviewed</span>: <time datetime={eventSnapshot.reviewedOn}
        >{eventSnapshot.reviewedOn}</time
      >.
    </p>
    {
      upcomingEvents.length ? (
        <EventList events={upcomingEvents.slice(0, 3)} />
      ) : (
        <p>No upcoming events in this snapshot.</p>
      )
    }
    <a href={withBase("/events/")}>All events and archive →</a>
  </section>
</BaseLayout>

<style>
  .home-intro {
    padding-top: clamp(1rem, 4vw, 3rem);
  }

  .home-tagline {
    max-width: 56ch;
    margin-block: var(--space-4) var(--space-5);
    color: var(--color-text-muted);
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 3vw, 1.85rem);
    line-height: 1.35;
  }

  .home-biography {
    max-width: var(--content-width);
  }

  .selected-publications {
    margin: var(--space-5) 0 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
    list-style: none;
  }

  .selected-publications li {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    line-height: 1.55;
  }
</style>
