---
import BaseLayout from "../layouts/BaseLayout.astro";
import Course from "../components/Course.astro";
import PageHeader from "../components/PageHeader.astro";
import { teachingCourses } from "../config/site";

const current = teachingCourses.filter((course) => course.current);
const past = teachingCourses
  .filter((course) => !course.current)
  .sort((a, b) => b.year - a.year);
---

<BaseLayout
  title="Teaching"
  description="Current and previous courses, notes, and assignments."
>
  <PageHeader
    eyebrow="Courses and materials"
    title="Teaching"
    lede="Course metadata is maintained beside the profile configuration, while reusable notes live in the MDX content collection."
  />

  <section class="section-block" aria-labelledby="current-courses">
    <h2 class="section-heading" id="current-courses">Current</h2>
    <div class="course-list">
      {current.map((course) => <Course course={course} />)}
    </div>
  </section>

  <section class="section-block" aria-labelledby="past-courses">
    <h2 class="section-heading" id="past-courses">Past</h2>
    <div class="course-list">
      {past.map((course) => <Course course={course} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .course-list {
    border-top: 1px solid var(--color-line);
  }
</style>
