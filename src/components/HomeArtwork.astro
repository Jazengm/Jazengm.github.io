---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import { withBase } from "../utils/paths";

const entries = (await getCollection("illustrations")).sort(
  (a, b) =>
    a.data.order - b.data.order || a.data.title.localeCompare(b.data.title),
);
const artworks = await Promise.all(
  entries.map(async ({ id, data }) => {
    const image = await getImage({
      src: data.image,
      width: Math.min(1920, data.image.width),
      format: "webp",
      quality: 85,
    });
    return {
      title: data.title,
      src: image.src,
      href: withBase(`/illustrations/${id}/`),
    };
  }),
);
const first = artworks[0];
---

{
  first && (
    <a
      class="home-artwork"
      href={first.href}
      aria-label={`View ${first.title}`}
      data-home-artwork
      data-artworks={JSON.stringify(artworks)}
      data-no-translate
    >
      <img src={first.src} alt="" decoding="async" fetchpriority="high" />
    </a>
  )
}

<script>
  import "../scripts/home-artwork";
</script>

<style>
  .home-artwork {
    position: absolute;
    inset: 0;
    overflow: hidden;
    color: var(--color-text);
    text-decoration: none;
  }

  .home-artwork img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .home-artwork::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      var(--color-bg) 0%,
      var(--color-bg) 15%,
      color-mix(in srgb, var(--color-bg) 85%, transparent) 42%,
      transparent 78%
    );
    content: "";
    pointer-events: none;
  }

  .home-artwork:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: -3px;
  }

  @media (max-width: 640px) {
    .home-artwork::after {
      background: linear-gradient(
        to right,
        var(--color-bg) 0%,
        color-mix(in srgb, var(--color-bg) 96%, transparent) 28%,
        color-mix(in srgb, var(--color-bg) 82%, transparent) 62%,
        transparent 100%
      );
    }
  }
</style>
