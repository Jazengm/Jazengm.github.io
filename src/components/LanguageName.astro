---
import { site } from "../config/site";
---

<div
  class="language-names"
  role="group"
  aria-label="Language / 语言"
  data-no-translate
>
  <button
    class="name-english"
    type="button"
    lang="en"
    data-language="en"
    data-name={site.name}
    aria-label={`${site.name} — English`}
    aria-pressed="true"><span class="name-label">{site.name}</span></button
  >
  <span class="name-divider" aria-hidden="true"></span>
  <button
    class="name-chinese"
    type="button"
    lang="zh-CN"
    data-language="zh-CN"
    data-name={site.chineseName}
    aria-label={`${site.chineseName} — 中文`}
    aria-pressed="false"
    ><span class="name-label">{site.chineseName}</span></button
  >
</div>

<style>
  .language-names {
    display: inline-grid;
    grid-template-columns: max-content 1px max-content;
    flex: 0 0 auto;
    align-items: center;
    column-gap: 1rem;
    white-space: nowrap;
  }
  .language-names button {
    display: inline-grid;
    flex: 0 0 auto;
    place-items: center;
    min-height: 2.75rem;
    padding: 0.2rem;
    border: 0;
    border-bottom: 2px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-primary-strong);
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 400;
    line-height: 1.6;
    white-space: nowrap;
    opacity: 0.65;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      opacity var(--transition-fast);
  }
  /* Measure the actual bold text instead of assuming a fixed font width. */
  .name-label,
  .language-names button::after {
    grid-area: 1 / 1;
  }
  .language-names button::after {
    content: attr(data-name);
    font-weight: 700;
    visibility: hidden;
    pointer-events: none;
  }
  .language-names .name-chinese {
    font-family: var(--font-sans);
    font-weight: 500;
  }
  .language-names .name-english {
    font-size: 1.05rem;
    padding-inline: 0.2rem 0.75rem;
  }
  .name-divider {
    width: 1px;
    height: 1.1rem;
    background: var(--color-text-muted);
  }
  .language-names button[aria-pressed="true"] {
    font-weight: 700;
    opacity: 1;
  }
  .language-names button[aria-pressed="false"]:is(:hover, :focus-visible) {
    opacity: 1;
    color: var(--color-secondary-strong);
    border-bottom-color: var(--color-secondary-strong);
  }
  @media (prefers-reduced-motion: reduce) {
    .language-names button {
      transition: none !important;
    }
  }
</style>
