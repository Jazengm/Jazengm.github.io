---
import { site } from "../config/site";
---

<div
  class="language-names"
  role="group"
  aria-label="Language / 语言"
  data-no-translate
>
  <button
    class="name-english"
    type="button"
    lang="en"
    data-language="en"
    aria-label={`${site.name} — English`}
    aria-pressed="true">{site.name}</button
  >
  <span class="name-divider" aria-hidden="true">|</span>
  <button
    class="name-chinese"
    type="button"
    lang="zh-CN"
    data-language="zh-CN"
    aria-label={`${site.chineseName} — 中文`}
    aria-pressed="false">{site.chineseName}</button
  >
</div>

<style>
  .language-names {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
  }
  .language-names button {
    min-height: 2.75rem;
    padding: 0.2rem 0.1rem;
    border: 0;
    border-bottom: 2px solid transparent;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-primary-strong);
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 400;
    line-height: 1.6;
    white-space: nowrap;
    opacity: 0.65;
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      opacity var(--transition-fast);
  }
  /* Reserve the bold name's width so switching never moves either label. */
  .name-english {
    width: 7.5rem;
  }
  .name-chinese {
    width: 4rem;
  }
  .name-divider {
    color: var(--color-text-muted);
  }
  .language-names button[aria-pressed="true"] {
    font-weight: 700;
    opacity: 1;
  }
  .language-names button[aria-pressed="false"]:is(:hover, :focus-visible) {
    opacity: 1;
    color: var(--color-secondary-strong);
    border-bottom-color: var(--color-secondary-strong);
  }
  @media (prefers-reduced-motion: reduce) {
    .language-names button {
      transition: none !important;
    }
  }
</style>
