---
import { site } from "../config/site";
---

<div
  class="language-names"
  role="group"
  aria-label="Language / 语言"
  data-no-translate
>
  <button
    class="name-english"
    type="button"
    lang="en"
    data-language="en"
    aria-label={`${site.name} — English`}
    aria-pressed="true"><span class="name-label">{site.name}</span></button
  >
  <span class="name-divider" aria-hidden="true">|</span>
  <button
    class="name-chinese"
    type="button"
    lang="zh-CN"
    data-language="zh-CN"
    aria-label={`${site.chineseName} — 中文`}
    aria-pressed="false"
    ><span class="name-label">{site.chineseName}</span></button
  >
</div>

<style>
  .language-names {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.3rem;
    white-space: nowrap;
  }
  .language-names button {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.2rem 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-primary-strong);
    cursor: pointer;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-weight: 400;
    line-height: 1.6;
    white-space: nowrap;
    opacity: 0.65;
    transition:
      color var(--transition-fast),
      opacity var(--transition-fast);
  }
  .language-names button::before,
  .language-names button::after,
  .name-divider::before,
  .name-divider::after {
    content: none;
    display: none;
  }
  .language-names .name-chinese {
    font-family: var(--font-sans);
    font-weight: 500;
  }
  .language-names .name-english {
    font-size: 1.05rem;
  }
  .name-divider {
    flex: 0 0 auto;
    display: block;
    width: auto;
    height: auto;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
    color: var(--color-primary-strong);
    font-family: var(--font-sans);
    font-size: 1.1rem;
    font-weight: 500;
    line-height: 1.6;
  }
  .language-names button[aria-pressed="true"] {
    font-weight: 700;
    opacity: 1;
  }
  .language-names button[aria-pressed="false"]:is(:hover, :focus-visible) {
    opacity: 1;
    color: var(--color-secondary-strong);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  .language-names button:focus-visible {
    outline: none;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  @media (prefers-reduced-motion: reduce) {
    .language-names button {
      transition: none !important;
    }
  }
</style>
